{
  "name": "basalt-db",
  "version": "0.1.0",
  "description": "A relational database engine written from scratch in TypeScript: pager, buffer pool, copy-on-write B+tree, snapshot-isolation MVCC, SQL parser, cost-based optimizer, Volcano executor. Runs in the browser (OPFS) and in Node.",
  "type": "module",
  "license": "MIT",
  "author": "Rahul Tarigoppula",
  "repository": "github:RahulTarigoppula/basalt-db",
  "homepage": "https://rahultarigoppula.github.io/basalt-db/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:slt": "vitest run tests/slt",
    "fuzz": "node --import tsx scripts/fuzz.ts",
    "bench": "node --import tsx bench/run.ts",
    "cli": "node --import tsx src/cli/repl.ts",
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "lint:text": "node scripts/lint-text.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
