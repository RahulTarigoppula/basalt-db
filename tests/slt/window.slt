# Window functions: ranking, offsets, aggregates as windows, frames (ROWS/RANGE/GROUPS), EXCLUDE, partitions.

statement ok
CREATE TABLE w(id INTEGER PRIMARY KEY, grp TEXT, v INTEGER)

statement ok
INSERT INTO w VALUES (1, 'a', 10), (2, 'a', 20), (3, 'a', 20), (4, 'b', 5), (5, 'b', NULL), (6, 'b', 7), (7, 'c', 1)

query IIII nosort
SELECT id, row_number() OVER (ORDER BY v, id), rank() OVER (ORDER BY v), dense_rank() OVER (ORDER BY v) FROM w ORDER BY id
----
1 5 5 5
2 6 6 6
3 7 6 6
4 3 3 3
5 1 1 1
6 4 4 4
7 2 2 2

query ITI nosort
SELECT id, grp, row_number() OVER (PARTITION BY grp ORDER BY v DESC, id) FROM w ORDER BY id
