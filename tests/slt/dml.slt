# DML and constraints: defaults, NOT NULL, UNIQUE, PRIMARY KEY, CHECK, OR REPLACE/IGNORE, upsert, RETURNING,
# UPDATE/DELETE with subqueries, rowid, ALTER TABLE, views, indexes, transactions.

statement ok
CREATE TABLE p(id INTEGER PRIMARY KEY, name TEXT NOT NULL, qty INTEGER DEFAULT 1 CHECK (qty >= 0), tag TEXT UNIQUE)

statement ok
