# Basic SELECT: projection, WHERE, ORDER BY, LIMIT/OFFSET, DISTINCT, expressions, NULL handling, compound selects.

statement ok
CREATE TABLE t1(a INTEGER, b TEXT, c REAL)

statement ok
INSERT INTO t1 VALUES (1, 'one', 1.5), (2, 'two', 2.5), (3, 'three', NULL), (NULL, 'null', 4.5), (5, NULL, 5.5), (2, 'two', 2.5)

query ITR nosort
SELECT a, b, c FROM t1 ORDER BY a, b, c
----
NULL null 4.5
1 one 1.5
2 two 2.5
2 two 2.5
3 three NULL
5 NULL 5.5

query I rowsort
SELECT a FROM t1 WHERE a > 1
----
2
2
3
5

query I rowsort
SELECT a FROM t1 WHERE a IS NULL OR a = 5
----
5
NULL

query IT nosort
SELECT DISTINCT a, b FROM t1 ORDER BY a NULLS LAST, b
----
1 one
2 two
3 three
5 NULL
NULL null

query I nosort
SELECT a FROM t1 ORDER BY a DESC NULLS LAST LIMIT 3
----
5
3
2

query I nosort
SELECT a FROM t1 WHERE a IS NOT NULL ORDER BY a LIMIT 2 OFFSET 2
----
2
3

query T nosort
SELECT b FROM t1 WHERE b LIKE 't%' ORDER BY b
----
three
two
two

query I nosort
SELECT count(*) FROM t1 WHERE b GLOB 't*'
----
3

query ITI nosort
SELECT a, b, a IN (1, 2) FROM t1 ORDER BY a NULLS FIRST, b
----
NULL null NULL
1 one 1
2 two 1
2 two 1
3 three 0
5 NULL 0

query IT nosort
SELECT a, CASE WHEN a < 2 THEN 'small' WHEN a < 4 THEN 'mid' ELSE 'big' END FROM t1 WHERE a IS NOT NULL ORDER BY a, b
----
1 small
2 mid
2 mid
3 mid
5 big

query IT nosort
SELECT a, CASE a WHEN 1 THEN 'x' WHEN 2 THEN 'y' END FROM t1 WHERE a IS NOT NULL ORDER BY a, b
----
1 x
2 y
2 y
3 NULL
5 NULL

query R nosort
SELECT c * 2 FROM t1 WHERE c IS NOT NULL ORDER BY c
----
3.0
5.0
5.0
9.0
11.0

query I nosort
SELECT a + 1 FROM t1 WHERE a BETWEEN 2 AND 3 ORDER BY a
----
