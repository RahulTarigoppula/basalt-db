query I nosort
SELECT count(*) FROM s WHERE k IN (SELECT k FROM s GROUP BY k HAVING count(*) > 1)
----
4

query TI nosort
SELECT g, (SELECT max(k) FROM s s2 WHERE s2.g = s.g) FROM s GROUP BY g ORDER BY g NULLS FIRST
