SELECT count(*), total(v) FROM s WHERE g = 'zzz'
----
0 0.0

query I nosort
SELECT sum(n) FROM s WHERE g = 'zzz'
----
NULL

query R nosort
SELECT avg(n) FROM s WHERE g = 'zzz'
----
NULL

query I nosort
SELECT max(k) FROM s WHERE k IS NULL
----
NULL

