1.5 7.25

query TT nosort
SELECT min(g), max(g) FROM s
----
a c

query I nosort
SELECT count(*) FROM s GROUP BY g HAVING min(k) = 1 ORDER BY 1
----
2
2

query TI nosort
SELECT g, k + 1 FROM s GROUP BY g, k + 1 ORDER BY 1 NULLS FIRST, 2 NULLS FIRST
----
