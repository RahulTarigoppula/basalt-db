# Aggregates: COUNT/SUM/TOTAL/AVG/MIN/MAX/GROUP_CONCAT, DISTINCT, FILTER, GROUP BY with NULLs, HAVING, empty input.

statement ok
CREATE TABLE s(g TEXT, k INTEGER, v REAL, n INTEGER)

statement ok
INSERT INTO s VALUES ('a', 1, 1.5, 10), ('a', 2, 2.5, NULL), ('b', 1, 3.0, 30), ('b', NULL, NULL, 40), (NULL, 3, 4.5, 50), (NULL, 3, 5.5, NULL), ('c', 7, 7.25, 70)

query IIRIIR nosort
SELECT count(*), count(v), sum(n), min(k), max(k), avg(v) FROM s
----
7 6 200.0 1 7 4.04166666666667

query TIIR nosort
SELECT g, count(*), count(k), sum(v) FROM s GROUP BY g ORDER BY g NULLS FIRST
----
NULL 2 2 10.0
a 2 2 4.0
b 2 1 3.0
c 1 1 7.25

query TI nosort
SELECT g, count(*) FROM s GROUP BY g HAVING count(*) > 1 ORDER BY g NULLS FIRST
----
NULL 2
a 2
b 2

query TI nosort
SELECT g, sum(n) FROM s GROUP BY g HAVING sum(n) IS NULL OR sum(n) > 50 ORDER BY g NULLS FIRST
----
b 70
c 70

query II nosort
SELECT k, count(*) FROM s GROUP BY k ORDER BY k NULLS FIRST
----
NULL 1
1 2
2 1
3 2
7 1

query TII nosort
SELECT g, k, count(*) FROM s GROUP BY g, k ORDER BY g NULLS FIRST, k NULLS FIRST
----
NULL 3 2
a 1 1
a 2 1
b NULL 1
b 1 1
c 7 1

query II nosort
SELECT count(DISTINCT k), count(DISTINCT g) FROM s
----
4 3

query I nosort
SELECT sum(DISTINCT k) FROM s
----
13

query T nosort
SELECT group_concat(k) FROM s WHERE g = 'a'
----
1,2

query T nosort
SELECT group_concat(g, '|') FROM (SELECT g FROM s WHERE g IS NOT NULL ORDER BY g)
----
a|a|b|b|c

query TT nosort
SELECT g, group_concat(k) FROM s WHERE g IS NOT NULL GROUP BY g ORDER BY g
----
a 1,2
b 1
c 7

query II nosort
SELECT count(*) FILTER (WHERE k > 1), sum(n) FILTER (WHERE g = 'b') FROM s
----
4 70

